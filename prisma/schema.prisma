generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenant raiz
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                   User[]
  people                  Person[]
  personRoles             PersonRole[]
  companies               Company[]
  bankAccounts            BankAccount[]
  developments            Development[]
  unitTypes               UnitType[]
  units                   Unit[]
  priceTables             PriceTable[]
  unitPrices              UnitPrice[]
  investments             Investment[]
  allocations             Allocation[]
  returns                 Return[]
  documents               Document[]
  interactions            Interaction[]
  invitations             UserInvitation[]
  auditLogs               AuditLog[]
  salesPipelines          SalesPipeline[]
  salesStages             SalesStage[]
  opportunities           Opportunity[]
  opportunityStageHistory OpportunityStageHistory[]
  salesActivities         SalesActivity[]
  unitReservations        UnitReservation[]
  salesProposals          SalesProposal[]
  proposalVersions        ProposalVersion[]
  proposalConditions      ProposalPaymentCondition[]
  sales                   Sale[]
  saleCancellations       SaleCancellation[]
  saleBuyers              SaleBuyer[]
  salePaymentPlans        SalePaymentPlan[]
  saleCommissions         SaleCommission[]
  receivables             Receivable[]
  financialPayments       FinancialPayment[]
  financialCategories     FinancialCategory[]
  costCenters             CostCenter[]
  payables                Payable[]
  financialTransactions   FinancialTransaction[]
  bankStatementEntries    BankStatementEntry[]
  collectionRules         CollectionRule[]
  collectionDispatches    CollectionDispatch[]
  monetaryIndices         MonetaryIndex[]
  monetaryIndexValues     MonetaryIndexValue[]
  receivableAdjustmentPolicies   ReceivableAdjustmentPolicy[]
  receivableAdjustments          ReceivableAdjustment[]
}

// ---------------------------------------------------------------------------
// Contas de login
// ---------------------------------------------------------------------------

model User {
  id                        String                    @id @default(cuid())
  email                     String                    @unique
  password                  String
  tokenVersion              Int                       @default(0)
  role                      UserRole                  @default(LEITURA)
  isActive                  Boolean                   @default(true)
  lastLoginAt               DateTime?
  invitedAt                 DateTime?
  acceptedAt                DateTime?
  name                      String
  organizationId            String
  organization              Organization              @relation(fields: [organizationId], references: [id])
  personId                  String?
  person                    Person?                   @relation(fields: [personId], references: [id], onDelete: SetNull)
  passwordResetTokens       PasswordResetToken[]
  invitationsSent           UserInvitation[]          @relation("UserInvitationInvitedBy")
  auditLogs                 AuditLog[]
  assignedOpportunities     Opportunity[]             @relation("OpportunityAssignedUser")
  opportunityStageChanges   OpportunityStageHistory[] @relation("OpportunityStageChangedBy")
  assignedSalesActivities   SalesActivity[]           @relation("SalesActivityAssignedUser")
  reservationsCreated       UnitReservation[]         @relation("UnitReservationCreatedBy")
  reservationsCancelled     UnitReservation[]         @relation("UnitReservationCancelledBy")
  reservationsConverted     UnitReservation[]         @relation("UnitReservationConvertedBy")
  proposalsCreated          SalesProposal[]           @relation("SalesProposalCreatedBy")
  proposalsSent             SalesProposal[]           @relation("SalesProposalSentBy")
  proposalsAccepted         SalesProposal[]           @relation("SalesProposalAcceptedBy")
  proposalsRejected         SalesProposal[]           @relation("SalesProposalRejectedBy")
  proposalVersionsCreated   ProposalVersion[]         @relation("ProposalVersionCreatedBy")
  proposalsConverted        SalesProposal[]           @relation("SalesProposalConvertedBy")
  salesCreated              Sale[]                    @relation("SaleCreatedBy")
  salesCancelled            SaleCancellation[]        @relation("SaleCancellationCancelledBy")
  saleCommissions           SaleCommission[]          @relation("SaleCommissionUser")
  financialPaymentsCreated  FinancialPayment[]        @relation("FinancialPaymentCreatedBy")
  financialPaymentsReversed FinancialPayment[]        @relation("FinancialPaymentReversedBy")
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  responsibleForMonetaryIndexValues   MonetaryIndexValue[] @relation("MonetaryIndexValue_responsible")
  appliedMonetaryIndexAdjustments     ReceivableAdjustment[] @relation("ReceivableAdjustment_appliedBy")

  @@index([organizationId, role])
  @@index([organizationId, isActive])
}

model UserInvitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           UserRole
  tokenHash      String       @unique
  invitedById    String
  invitedBy      User         @relation("UserInvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, createdAt])
  @@index([organizationId, email])
  @@index([email, acceptedAt, revokedAt, expiresAt])
  @@index([expiresAt])
  @@index([invitedById])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Auditoria imutavel na camada de aplicacao
// ---------------------------------------------------------------------------

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUserId    String?
  actor          User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, action, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([actorUserId, createdAt])
}

// ---------------------------------------------------------------------------
// Pessoas e papéis
// ---------------------------------------------------------------------------

model Person {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  name           String
  documentType   PersonDocumentType
  document       String
  personType     PersonType
  email          String?
  phone          String?
  address        String?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  roles            PersonRole[]
  users            User[]
  investments      Investment[]
  documents        Document[]
  interactions     Interaction[]
  opportunities    Opportunity[]
  salesActivities  SalesActivity[]
  unitReservations UnitReservation[]
  salesProposals   SalesProposal[]
  saleBuyers       SaleBuyer[]
  saleCommissions  SaleCommission[]
  suppliedPayables Payable[]         @relation("PayableSupplier")

  @@unique([organizationId, document])
}

model PersonRole {
  id             String         @id @default(cuid())
  personId       String
  person         Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  role           PersonRoleType
  createdAt      DateTime       @default(now())

  @@unique([personId, role])
}

// ---------------------------------------------------------------------------
// Empresas (SPE / Incorporadora) e contas bancárias
// ---------------------------------------------------------------------------

model Company {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  cnpj           String
  type           CompanyType
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  developments          Development[]
  bankAccounts          BankAccount[]
  receivables           Receivable[]
  costCenters           CostCenter[]
  payables              Payable[]
  financialTransactions FinancialTransaction[]
  statementEntries      BankStatementEntry[]
}

model BankAccount {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  bank           String
  agency         String
  account        String
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  receivables           Receivable[]
  financialPayments     FinancialPayment[]
  payables              Payable[]
  financialTransactions FinancialTransaction[]
  BankStatementEntry    BankStatementEntry[]
}

// ---------------------------------------------------------------------------
// Empreendimentos, tipologias, unidades e preços
// ---------------------------------------------------------------------------

model Development {
  id                   String            @id @default(cuid())
  organizationId       String
  organization         Organization      @relation(fields: [organizationId], references: [id])
  name                 String
  description          String?
  type                 DevelopmentType
  companyId            String?
  company              Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  address              String?
  city                 String?
  status               DevelopmentStatus @default(EM_CAPTACAO)
  expectedLaunchDate   DateTime?
  expectedDeliveryDate DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  unitTypes             UnitType[]
  units                 Unit[]
  priceTables           PriceTable[]
  allocations           Allocation[]
  documents             Document[]
  opportunities         Opportunity[]
  sales                 Sale[]
  costCenters           CostCenter[]
  payables              Payable[]
  financialTransactions FinancialTransaction[]
}

model UnitType {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  developmentId  String
  development    Development  @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  name           String
  bedrooms       Int?
  suites         Int?
  standardArea   Float?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  units Unit[]
}

model Unit {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  developmentId  String
  development    Development  @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  identifier     String
  unitTypeId     String?
  unitType       UnitType?    @relation(fields: [unitTypeId], references: [id], onDelete: SetNull)
  category       UnitCategory
  grouping       String?
  landArea       Float?
  builtArea      Float?
  parkingSpots   Int?
  status         UnitStatus   @default(DISPONIVEL)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  prices         UnitPrice[]
  documents      Document[]
  opportunities  Opportunity[]
  reservations   UnitReservation[]
  salesProposals SalesProposal[]
  sales          Sale[]
}

// ---------------------------------------------------------------------------
// CRM comercial
// ---------------------------------------------------------------------------

model SalesPipeline {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  isDefault      Boolean      @default(false)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  stages        SalesStage[]
  opportunities Opportunity[]

  @@index([organizationId, isActive])
  @@index([organizationId, createdAt])
}

model SalesStage {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipelineId     String
  pipeline       SalesPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name           String
  code           String
  position       Int
  colorKey       String
  isWon          Boolean       @default(false)
  isLost         Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  opportunities Opportunity[]
  historyFrom   OpportunityStageHistory[] @relation("OpportunityHistoryFromStage")
  historyTo     OpportunityStageHistory[] @relation("OpportunityHistoryToStage")

  @@unique([pipelineId, code])
  @@unique([pipelineId, position])
  @@index([organizationId, pipelineId])
}

model Opportunity {
  id                String        @id @default(cuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  personId          String
  person            Person        @relation(fields: [personId], references: [id], onDelete: Restrict)
  pipelineId        String
  pipeline          SalesPipeline @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stageId           String
  stage             SalesStage    @relation(fields: [stageId], references: [id], onDelete: Restrict)
  assignedUserId    String?
  assignedUser      User?         @relation("OpportunityAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  developmentId     String?
  development       Development?  @relation(fields: [developmentId], references: [id], onDelete: SetNull)
  unitId            String?
  unit              Unit?         @relation(fields: [unitId], references: [id], onDelete: SetNull)
  source            String?
  estimatedValue    Decimal?      @db.Decimal(18, 2)
  probability       Int?
  nextContactAt     DateTime?
  expectedCloseDate DateTime?
  lostReason        String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  stageHistory   OpportunityStageHistory[]
  activities     SalesActivity[]
  reservations   UnitReservation[]
  salesProposals SalesProposal[]
  sales          Sale[]

  @@index([organizationId, stageId, createdAt])
  @@index([organizationId, pipelineId, createdAt])
  @@index([organizationId, assignedUserId, createdAt])
  @@index([organizationId, developmentId, createdAt])
  @@index([organizationId, personId, createdAt])
  @@index([organizationId, unitId])
  @@index([organizationId, nextContactAt])
}

model OpportunityStageHistory {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunityId   String
  opportunity     Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fromStageId     String?
  fromStage       SalesStage?  @relation("OpportunityHistoryFromStage", fields: [fromStageId], references: [id], onDelete: Restrict)
  toStageId       String
  toStage         SalesStage   @relation("OpportunityHistoryToStage", fields: [toStageId], references: [id], onDelete: Restrict)
  changedByUserId String
  changedByUser   User         @relation("OpportunityStageChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)
  changedAt       DateTime     @default(now())

  @@index([organizationId, opportunityId, changedAt])
  @@index([changedByUserId, changedAt])
}

model SalesActivity {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunityId  String
  opportunity    Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  personId       String
  person         Person            @relation(fields: [personId], references: [id], onDelete: Restrict)
  assignedUserId String?
  assignedUser   User?             @relation("SalesActivityAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  type           SalesActivityType
  scheduledAt    DateTime?
  completedAt    DateTime?
  summary        String?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId, opportunityId, createdAt])
  @@index([organizationId, personId, createdAt])
  @@index([organizationId, assignedUserId, scheduledAt])
  @@index([organizationId, completedAt, scheduledAt])
}

// ---------------------------------------------------------------------------
// Reservas comerciais de unidades
// ---------------------------------------------------------------------------

model UnitReservation {
  id                 String                @id @default(cuid())
  organizationId     String
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unitId             String
  unit               Unit                  @relation(fields: [unitId], references: [id], onDelete: Restrict)
  personId           String
  person             Person                @relation(fields: [personId], references: [id], onDelete: Restrict)
  opportunityId      String?
  opportunity        Opportunity?          @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  createdByUserId    String
  createdByUser      User                  @relation("UnitReservationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  startsAt           DateTime              @default(now())
  expiresAt          DateTime
  status             UnitReservationStatus @default(ATIVA)
  notes              String?
  cancelledAt        DateTime?
  cancelledByUserId  String?
  cancelledByUser    User?                 @relation("UnitReservationCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  cancellationReason String?
  convertedAt        DateTime?
  convertedByUserId  String?
  convertedByUser    User?                 @relation("UnitReservationConvertedBy", fields: [convertedByUserId], references: [id], onDelete: Restrict)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  salesProposals     SalesProposal[]

  @@index([organizationId, status, expiresAt])
  @@index([organizationId, unitId, createdAt])
  @@index([organizationId, personId, createdAt])
  @@index([organizationId, opportunityId, createdAt])
}

// ---------------------------------------------------------------------------
// Propostas comerciais versionadas
// ---------------------------------------------------------------------------

model SalesProposal {
  id                      String              @id @default(cuid())
  organizationId          String
  organization            Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunityId           String?
  opportunity             Opportunity?        @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  reservationId           String?
  reservation             UnitReservation?    @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  personId                String
  person                  Person              @relation(fields: [personId], references: [id], onDelete: Restrict)
  unitId                  String
  unit                    Unit                @relation(fields: [unitId], references: [id], onDelete: Restrict)
  status                  SalesProposalStatus @default(RASCUNHO)
  currentVersionId        String?             @unique
  currentVersion          ProposalVersion?    @relation("CurrentProposalVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  validUntil              DateTime?
  createdByUserId         String
  createdByUser           User                @relation("SalesProposalCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  sentAt                  DateTime?
  sentByUserId            String?
  sentByUser              User?               @relation("SalesProposalSentBy", fields: [sentByUserId], references: [id], onDelete: Restrict)
  acceptedAt              DateTime?
  acceptedByUserId        String?
  acceptedByUser          User?               @relation("SalesProposalAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: Restrict)
  rejectedAt              DateTime?
  rejectedByUserId        String?
  rejectedByUser          User?               @relation("SalesProposalRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: Restrict)
  rejectionReason         String?
  convertedToSaleAt       DateTime?
  convertedToSaleByUserId String?
  convertedToSaleByUser   User?               @relation("SalesProposalConvertedBy", fields: [convertedToSaleByUserId], references: [id], onDelete: Restrict)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  versions ProposalVersion[] @relation("ProposalVersions")
  sale     Sale?

  @@index([organizationId, opportunityId, createdAt])
  @@index([organizationId, reservationId, createdAt])
  @@index([organizationId, personId, createdAt])
  @@index([organizationId, unitId, createdAt])
  @@index([organizationId, status, validUntil])
}

model ProposalVersion {
  id                   String        @id @default(cuid())
  organizationId       String
  organization         Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposalId           String
  proposal             SalesProposal @relation("ProposalVersions", fields: [proposalId], references: [id], onDelete: Cascade)
  version              Int
  basePrice            Decimal       @db.Decimal(18, 2)
  discount             Decimal       @db.Decimal(18, 2)
  finalPrice           Decimal       @db.Decimal(18, 2)
  downPayment          Decimal       @db.Decimal(18, 2)
  validUntil           DateTime?
  notes                String?
  sourcePriceTableId   String?
  sourcePriceTableName String?
  createdByUserId      String
  createdByUser        User          @relation("ProposalVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt            DateTime      @default(now())

  conditions         ProposalPaymentCondition[]
  currentForProposal SalesProposal?             @relation("CurrentProposalVersion")

  @@unique([proposalId, version])
  @@index([organizationId, proposalId, createdAt])
}

model ProposalPaymentCondition {
  id             String                       @id @default(cuid())
  organizationId String
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versionId      String
  version        ProposalVersion              @relation(fields: [versionId], references: [id], onDelete: Cascade)
  type           ProposalPaymentConditionType
  amount         Decimal                      @db.Decimal(18, 2)
  installments   Int?
  firstDueDate   DateTime?
  intervalMonths Int?
  description    String?
  position       Int
  createdAt      DateTime                     @default(now())

  @@index([organizationId, versionId, position])
}

// ---------------------------------------------------------------------------
// Vendas imobiliárias formais
// ---------------------------------------------------------------------------

model Sale {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  developmentId   String
  development     Development    @relation(fields: [developmentId], references: [id], onDelete: Restrict)
  unitId          String
  unit            Unit           @relation(fields: [unitId], references: [id], onDelete: Restrict)
  opportunityId   String?
  opportunity     Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  proposalId      String?        @unique
  proposal        SalesProposal? @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  saleNumber      String
  status          SaleStatus     @default(ATIVA)
  saleDate        DateTime
  grossAmount     Decimal        @db.Decimal(18, 2)
  discountAmount  Decimal        @db.Decimal(18, 2)
  netAmount       Decimal        @db.Decimal(18, 2)
  notes           String?
  createdByUserId String
  createdByUser   User           @relation("SaleCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  cancelledAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  buyers      SaleBuyer[]
  paymentPlan SalePaymentPlan[]
  commissions SaleCommission[]
  receivables Receivable[]
  cancellation SaleCancellation?

  @@unique([organizationId, saleNumber])
  @@index([organizationId, status, saleDate])
  @@index([organizationId, developmentId, saleDate])
  @@index([organizationId, unitId, status])
  @@index([organizationId, opportunityId])
}

model SaleCancellation {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  saleId            String       @unique
  sale              Sale         @relation(fields: [saleId], references: [id], onDelete: Restrict)
  reason            String
  cancelledByUserId String
  cancelledByUser   User         @relation("SaleCancellationCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  createdAt         DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, cancelledByUserId])
}

model SaleBuyer {
  id                      String       @id @default(cuid())
  organizationId          String
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  saleId                  String
  sale                    Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  personId                String
  person                  Person       @relation(fields: [personId], references: [id], onDelete: Restrict)
  participationPercentage Decimal?     @db.Decimal(5, 2)
  isPrimary               Boolean      @default(false)
  createdAt               DateTime     @default(now())

  @@unique([saleId, personId])
  @@index([organizationId, personId, createdAt])
  @@index([organizationId, saleId])
}

model SalePaymentPlan {
  id             String                       @id @default(cuid())
  organizationId String
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  saleId         String
  sale           Sale                         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  type           ProposalPaymentConditionType
  amount         Decimal                      @db.Decimal(18, 2)
  installments   Int?
  firstDueDate   DateTime?
  intervalMonths Int?
  description    String?
  position       Int
  createdAt      DateTime                     @default(now())

  receivables Receivable[]

  @@index([organizationId, saleId, position])
}

model SaleCommission {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  saleId         String
  sale           Sale                 @relation(fields: [saleId], references: [id], onDelete: Cascade)
  personId       String?
  person         Person?              @relation(fields: [personId], references: [id], onDelete: Restrict)
  userId         String?
  user           User?                @relation("SaleCommissionUser", fields: [userId], references: [id], onDelete: Restrict)
  percentage     Decimal?             @db.Decimal(5, 2)
  amount         Decimal              @db.Decimal(18, 2)
  status         SaleCommissionStatus @default(PREVISTA)
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  payable Payable?

  @@index([organizationId, saleId, status])
  @@index([organizationId, personId])
  @@index([organizationId, userId])
}

// ---------------------------------------------------------------------------
// Parcelas e contas a receber
// ---------------------------------------------------------------------------

model Receivable {
  id                String               @id @default(cuid())
  organizationId    String
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId         String?
  company           Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  bankAccountId     String?
  bankAccount       BankAccount?         @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  saleId            String?
  sale              Sale?                @relation(fields: [saleId], references: [id], onDelete: Restrict)
  salePaymentPlanId String?
  salePaymentPlan   SalePaymentPlan?     @relation(fields: [salePaymentPlanId], references: [id], onDelete: Restrict)
  sourceType        ReceivableSourceType
  sourceId          String
  sourceSequence    Int
  description       String
  dueDate           DateTime
  originalAmount    Decimal              @db.Decimal(18, 2)
  adjustedAmount    Decimal              @db.Decimal(18, 2)
  paidAmount        Decimal              @default(0) @db.Decimal(18, 2)
  status            ReceivableStatus     @default(PENDENTE)
  paidAt            DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  payments             FinancialPayment[]
  transactions         FinancialTransaction[]
  collectionDispatches CollectionDispatch[]
  adjustmentPolicies    ReceivableAdjustmentPolicy[]
  adjustments           ReceivableAdjustment[]

  @@unique([organizationId, sourceType, sourceId, sourceSequence])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, saleId, dueDate])
  @@index([organizationId, companyId, dueDate])
  @@index([organizationId, bankAccountId, dueDate])
}

// ---------------------------------------------------------------------------
// Cobrança automatizada
// ---------------------------------------------------------------------------

model CollectionRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  daysOffset     Int
  subject        String
  message        String
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  dispatches CollectionDispatch[]

  @@unique([organizationId, name])
  @@index([organizationId, active, daysOffset])
}

model CollectionDispatch {
  id                String                   @id @default(cuid())
  organizationId    String
  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ruleId            String
  rule              CollectionRule           @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  receivableId      String
  receivable        Receivable               @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  status            CollectionDispatchStatus @default(PENDENTE)
  scheduledFor      DateTime
  recipient         String?
  subject           String
  message           String
  balanceSnapshot   Decimal                  @db.Decimal(18, 2)
  attemptCount      Int                      @default(0)
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  providerMessageId String?
  failureReason     String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([ruleId, receivableId, scheduledFor])
  @@index([organizationId, status, scheduledFor])
  @@index([organizationId, receivableId, createdAt])
}

model FinancialPayment {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receivableId     String?
  receivable       Receivable?  @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  payableId        String?
  payable          Payable?     @relation(fields: [payableId], references: [id], onDelete: Restrict)
  bankAccountId    String
  bankAccount      BankAccount  @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  amount           Decimal      @db.Decimal(18, 2)
  paidAt           DateTime
  notes            String?
  createdByUserId  String
  createdByUser    User         @relation("FinancialPaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reversedAt       DateTime?
  reversedByUserId String?
  reversedByUser   User?        @relation("FinancialPaymentReversedBy", fields: [reversedByUserId], references: [id], onDelete: Restrict)
  reversalReason   String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  transaction FinancialTransaction?

  @@index([organizationId, receivableId, paidAt])
  @@index([organizationId, payableId, paidAt])
  @@index([organizationId, bankAccountId, paidAt])
  @@index([organizationId, reversedAt])
}

// ---------------------------------------------------------------------------
// Núcleo financeiro geral
// ---------------------------------------------------------------------------

model FinancialCategory {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  type           FinancialCategoryType
  isDefault      Boolean               @default(false)
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  payables Payable[]

  @@unique([organizationId, name, type])
  @@index([organizationId, type, active])
}

model CostCenter {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  developmentId  String?
  development    Development? @relation(fields: [developmentId], references: [id], onDelete: SetNull)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  payables     Payable[]
  transactions FinancialTransaction[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
  @@index([organizationId, companyId])
  @@index([organizationId, developmentId])
}

model Payable {
  id               String             @id @default(cuid())
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId        String?
  company          Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  developmentId    String?
  development      Development?       @relation(fields: [developmentId], references: [id], onDelete: SetNull)
  bankAccountId    String?
  bankAccount      BankAccount?       @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  categoryId       String?
  category         FinancialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  costCenterId     String?
  costCenter       CostCenter?        @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  supplierPersonId String?
  supplierPerson   Person?            @relation("PayableSupplier", fields: [supplierPersonId], references: [id], onDelete: SetNull)
  saleCommissionId String?            @unique
  saleCommission   SaleCommission?    @relation(fields: [saleCommissionId], references: [id], onDelete: Restrict)
  investorReturnId String?            @unique
  investorReturn   Return?            @relation(fields: [investorReturnId], references: [id], onDelete: Restrict)
  description      String
  dueDate          DateTime
  originalAmount   Decimal            @db.Decimal(18, 2)
  paidAmount       Decimal            @default(0) @db.Decimal(18, 2)
  status           PayableStatus      @default(PENDENTE)
  sourceType       PayableSourceType?
  sourceId         String?
  paidAt           DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  payments     FinancialPayment[]
  transactions FinancialTransaction[]

  @@unique([organizationId, sourceType, sourceId])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, companyId, dueDate])
  @@index([organizationId, developmentId, dueDate])
  @@index([organizationId, costCenterId, dueDate])
}

model FinancialTransaction {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccountId  String
  bankAccount    BankAccount              @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  companyId      String?
  company        Company?                 @relation(fields: [companyId], references: [id], onDelete: SetNull)
  developmentId  String?
  development    Development?             @relation(fields: [developmentId], references: [id], onDelete: SetNull)
  costCenterId   String?
  costCenter     CostCenter?              @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  paymentId      String                   @unique
  payment        FinancialPayment         @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  receivableId   String?
  receivable     Receivable?              @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  payableId      String?
  payable        Payable?                 @relation(fields: [payableId], references: [id], onDelete: Restrict)
  type           FinancialTransactionType
  amount         Decimal                  @db.Decimal(18, 2)
  date           DateTime
  description    String
  reversedAt     DateTime?
  createdAt      DateTime                 @default(now())

  statementEntry BankStatementEntry?

  @@index([organizationId, date, type])
  @@index([organizationId, companyId, date])
  @@index([organizationId, developmentId, date])
  @@index([organizationId, costCenterId, date])
  @@index([organizationId, bankAccountId, date])
}

model BankStatementEntry {
  id                   String                   @id @default(cuid())
  organizationId       String
  organization         Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccountId        String
  bankAccount          BankAccount              @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  externalId           String?
  fingerprint          String
  date                 DateTime
  description          String
  type                 BankStatementEntryType
  amount               Decimal                  @db.Decimal(18, 2)
  status               BankReconciliationStatus @default(PENDENTE)
  matchedTransactionId String?                  @unique
  matchedTransaction   FinancialTransaction?    @relation(fields: [matchedTransactionId], references: [id], onDelete: SetNull)
  reconciledAt         DateTime?
  ignoredAt            DateTime?
  importedAt           DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  Company              Company?                 @relation(fields: [companyId], references: [id])
  companyId            String?

  @@unique([organizationId, bankAccountId, fingerprint])
  @@index([organizationId, bankAccountId, status, date])
  @@index([organizationId, status, date])
}

model PriceTable {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  developmentId  String
  development    Development  @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  name           String
  phase          String
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  unitPrices UnitPrice[]
}

model UnitPrice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  unitId         String
  unit           Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  priceTableId   String
  priceTable     PriceTable   @relation(fields: [priceTableId], references: [id], onDelete: Cascade)
  value          Float
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([unitId, priceTableId])
}

// ---------------------------------------------------------------------------
// Investimentos, alocações e retornos
// ---------------------------------------------------------------------------

model Investment {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  investorId     String
  investor       Person         @relation(fields: [investorId], references: [id])
  amount         Float
  date           DateTime
  type           InvestmentType @default(FINANCEIRO)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  allocations Allocation[]
  documents   Document[]
}

model Allocation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  investmentId   String
  investment     Investment   @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  developmentId  String?
  development    Development? @relation(fields: [developmentId], references: [id], onDelete: SetNull)
  amount         Float
  date           DateTime
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  returns Return[]
}

model Return {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  allocationId   String
  allocation     Allocation   @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  expectedAmount Float
  expectedDate   DateTime
  realizedDate   DateTime?
  realizedAmount Float?
  status         ReturnStatus @default(PENDENTE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  payable Payable?
}

// ---------------------------------------------------------------------------
// Documentos e interações
// ---------------------------------------------------------------------------

model Document {
  id              String           @id @default(cuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id])
  name            String
  // Preserved for compatibility; stores the authenticated download endpoint.
  fileUrl         String
  storageKey      String
  storageProvider String
  originalName    String
  mimeType        String
  size            Int
  category        DocumentCategory @default(OUTRO)
  personId        String?
  person          Person?          @relation(fields: [personId], references: [id], onDelete: SetNull)
  investmentId    String?
  investment      Investment?      @relation(fields: [investmentId], references: [id], onDelete: SetNull)
  unitId          String?
  unit            Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  developmentId   String?
  development     Development?     @relation(fields: [developmentId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Interaction {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  personId       String
  person         Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
  date           DateTime
  type           InteractionType @default(OUTRO)
  summary        String
  nextStep       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

