DATABASE_URL="postgresql://..."
JWT_SECRET="secret"
JWT_EXPIRES_IN="7d"
PORT=3000

# Document storage. Local is the safe default for development only.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# Required when STORAGE_DRIVER=s3. The bucket must remain private.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
SIGNED_URL_EXPIRATION_SECONDS=300
