DATABASE_URL="postgresql://..."
JWT_SECRET="secret"
JWT_EXPIRES_IN="7d"
PORT=3000

# Authentication and password recovery. The notifier is intentionally a no-op
# until a real provider is integrated; it never logs reset links or tokens.
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
PASSWORD_RESET_FRONTEND_URL=http://localhost:3000/reset-password

# Internal user invitations. Delivery is intentionally suppressed by the
# default notifier; no raw token or invitation URL is logged.
USER_INVITATION_TTL_SECONDS=604800
USER_INVITATION_FRONTEND_URL=http://localhost:4200/accept-invitation

# Authentication rate limits. Values are request counts and windows in seconds.
AUTH_THROTTLE_LOGIN_LIMIT=5
AUTH_THROTTLE_LOGIN_TTL_SECONDS=60
AUTH_THROTTLE_REGISTER_LIMIT=3
AUTH_THROTTLE_REGISTER_TTL_SECONDS=3600
AUTH_THROTTLE_FORGOT_LIMIT=3
AUTH_THROTTLE_FORGOT_TTL_SECONDS=900
AUTH_THROTTLE_RESET_LIMIT=5
AUTH_THROTTLE_RESET_TTL_SECONDS=900
AUTH_THROTTLE_ACCEPT_LIMIT=5
AUTH_THROTTLE_ACCEPT_TTL_SECONDS=900

# Document storage. Local is the safe default for development only.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# Required when STORAGE_DRIVER=s3. The bucket must remain private.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
SIGNED_URL_EXPIRATION_SECONDS=300

# Automated collections. Keep secrets server-side. Rules start disabled and
# must be explicitly activated by a financial user.
COLLECTION_AUTOMATION_ENABLED=true
COLLECTION_FROM_EMAIL=
RESEND_API_KEY=
